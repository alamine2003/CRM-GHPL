{
  "cli": {
    "version": ">= 16.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "apercu": {
      "distribution": "internal",
      "environment": "preview",
      "android": { "buildType": "apk" }
    },
    "simulateur": {
      "extends": "apercu",
      "ios": { "simulator": true }
    },
    "recette": {
      "distribution": "store",
      "environment": "preview",
      "autoIncrement": true,
      "android": { "buildType": "app-bundle" }
    }
  },
  "submit": {
    "recette": {}
  }
}
