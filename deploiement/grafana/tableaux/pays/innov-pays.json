{
  "uid": "innov-pays",
  "title": "INNOV CRM — pilotage du pays",
  "description": "Agrégats du pays, par jour et par réseau (DSH-010 CA1). Le rôle de la source ne lit que les vues de son pays.",
  "editable": false,
  "schemaVersion": 39,
  "time": {
    "from": "now-30d",
    "to": "now"
  },
  "refresh": "1h",
  "tags": ["innov"],
  "templating": {
    "list": [
      {
        "name": "source",
        "label": "Source",
        "type": "datasource",
        "query": "grafana-postgresql-datasource",
        "hide": 0
      },
      {
        "name": "pays",
        "label": "Code du pays",
        "type": "textbox",
        "query": "sn",
        "hide": 0,
        "description": "Code de l'organisation : sn, tg…"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Fraîcheur des données (DSH-011)",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${source}"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT max(calcule_le) AS \"Calculé le\" FROM pilotage.${pays}_fraicheur"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "dateTimeFromNow"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Réalisation (KPI-03)",
      "type": "stat",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${source}"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT round(100.0 * sum(visites_effectuees_prevues) / nullif(sum(visites_echues), 0)) AS \"Réalisation\" FROM pilotage.${pays}_pays_jour WHERE $__timeFilter(jour::timestamptz)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Écarts justifiés (DC-50)",
      "type": "stat",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${source}"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT round(100.0 * sum(ecarts_justifies) / nullif(sum(ecarts), 0)) AS \"Écarts justifiés\" FROM pilotage.${pays}_pays_jour WHERE $__timeFilter(jour::timestamptz)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Rapports dans le délai (KPI-04)",
      "type": "stat",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${source}"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT round(100.0 * sum(rapports_dans_delai) / nullif(sum(rapports_soumis), 0)) AS \"Dans le délai\" FROM pilotage.${pays}_pays_jour WHERE $__timeFilter(jour::timestamptz)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Visites par jour",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${source}"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "time_series",
          "rawSql": "SELECT jour::timestamptz AS time, sum(visites_echues) AS \"Prévues échues\", sum(visites_effectuees) AS \"Faites\", sum(visites_imprevues) AS \"Imprévues\" FROM pilotage.${pays}_pays_jour WHERE $__timeFilter(jour::timestamptz) GROUP BY 1 ORDER BY 1"
        }
      ]
    },
    {
      "id": 6,
      "title": "Par réseau (sans classement, DC-49)",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 13,
        "w": 24,
        "h": 9
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "${source}"
      },
      "targets": [
        {
          "refId": "A",
          "rawQuery": true,
          "editorMode": "code",
          "format": "table",
          "rawSql": "SELECT reseau AS \"Réseau\", sum(visites_effectuees) AS \"Visites faites\", round(100.0 * sum(visites_effectuees_prevues) / nullif(sum(visites_echues), 0)) AS \"Réalisation (%)\", round(100.0 * sum(visites_geolocalisees) / nullif(sum(visites_effectuees), 0)) AS \"Géolocalisées (%)\" FROM pilotage.${pays}_reseau_jour WHERE $__timeFilter(jour::timestamptz) GROUP BY reseau ORDER BY reseau"
        }
      ]
    }
  ]
}
