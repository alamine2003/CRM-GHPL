# Modèle de configuration locale du serveur. Copier en .env si besoin ; ne jamais versionner .env.
ENVIRONNEMENT=developpement
DATABASE_URL=postgres://innov@localhost:5432/innov
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:8081
# DJANGO_SECRET_KEY est obligatoire hors développement (variable de l'hébergeur).
PORTAIL_URL=http://localhost:5173
# Courriels de sécurité (récupération d'accès, verrouillage). Console en développement.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# REDIS_URL=redis://localhost:6379/0  (limites de débit partagées entre instances)
# Démonstration (DEM-001) : mot de passe commun des comptes fictifs, choisi localement.
# INNOV_DEMO_MOT_DE_PASSE=
# Suivi des erreurs (Sentry) : laisser vide tant que le service n'est pas choisi.
# SENTRY_DSN=
# Journaux en texte lisible en local (JSON par défaut).
# JOURNAUX_LISIBLES=1
# Vérification des fuites de mots de passe (active par défaut hors développement).
# INNOV_VERIFIER_FUITES=1
