# Modèle de configuration locale du serveur. Copier en .env si besoin ; ne jamais versionner .env.
ENVIRONNEMENT=developpement
DATABASE_URL=postgres://innov@localhost:5432/innov
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
