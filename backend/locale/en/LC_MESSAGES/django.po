# Traductions anglaises du service central INNOV CRM.
# La langue source est le français.
msgid ""
msgstr ""
"Project-Id-Version: INNOV CRM\n"
"Report-Msgid-Bugs-To: \n"
"POT-Creation-Date: 2026-10-04 21:38+0000\n"
"Language: en\n"
"MIME-Version: 1.0\n"
"Content-Type: text/plain; charset=UTF-8\n"
"Content-Transfer-Encoding: 8bit\n"
"Plural-Forms: nplurals=2; plural=(n != 1);\n"

msgid "INNOV CRM — réinitialisation de votre mot de passe"
msgstr "INNOV CRM — reset your password"

#, python-format
msgid ""
"Bonjour %(prenom)s,\n"
"\n"
"Pour choisir un nouveau mot de passe, ouvrez ce lien dans les %(minutes)s minutes :\n"
"%(lien)s\n"
"\n"
"Le lien ne fonctionne qu'une fois. Si vous n'êtes pas à l'origine de cette demande, ignorez ce message : votre mot de passe actuel reste valable."
msgstr ""
"Hello %(prenom)s,\n"
"\n"
"To choose a new password, open this link within %(minutes)s minutes:\n"
"%(lien)s\n"
"\n"
"The link works only once. If you did not request this, ignore this message: your current password remains valid."

msgid "INNOV CRM — compte verrouillé temporairement"
msgstr "INNOV CRM — account temporarily locked"

#, python-format
msgid ""
"Bonjour %(prenom)s,\n"
"\n"
"Après plusieurs mots de passe erronés, votre compte est verrouillé pour %(minutes)s minutes. Si ce n'était pas vous, prévenez votre administrateur pays."
msgstr ""
"Hello %(prenom)s,\n"
"\n"
"After several wrong passwords, your account is locked for %(minutes)s minutes. If this was not you, tell your country administrator."

msgid ""
"La double authentification doit être réinitialisée par votre administrateur."
msgstr "Two-step verification must be reset by your administrator."

msgid "La double authentification est déjà active."
msgstr "Two-step verification is already active."

msgid "Commencez par afficher le QR code."
msgstr "Start by displaying the QR code."

msgid "Code incorrect ou expiré."
msgstr "Incorrect or expired code."

msgid ""
"Votre rôle impose la double authentification : elle ne peut pas être "
"désactivée."
msgstr "Your role requires two-step verification: it cannot be turned off."

#, python-format
msgid "Ce mot de passe peut être compromettant : il contient « %(mot)s »."
msgstr "This password may be compromising: it contains “%(mot)s”."

msgid ""
"Votre mot de passe ne doit contenir ni le nom de l'entreprise, ni un mot du "
"métier, ni un nom de pays ou de ville, ni un mot de passe courant."
msgstr ""
"Your password must not contain the company name, a business word, a country "
"or city name, or a common password."

msgid ""
"Ce mot de passe peut être compromettant : il figure dans des fuites de "
"données connues. Choisissez-en un autre."
msgstr ""
"This password may be compromising: it appears in known data breaches. Choose"
" another one."

msgid ""
"Votre mot de passe ne doit pas figurer dans des fuites de données connues."
msgstr "Your password must not appear in known data breaches."

msgid "Un compte nominatif a un prénom et un nom (USR-001)."
msgstr "A named account has a first name and a last name (USR-001)."

msgid "Ce compte est désactivé. Contactez votre administrateur pays."
msgstr "This account is disabled. Contact your country administrator."

#, python-format
msgid ""
"Le pays %(pays)s est suspendu : la connexion est momentanément impossible."
msgstr ""
"The country %(pays)s is suspended: sign-in is temporarily unavailable."

#, python-format
msgid "Le pays %(pays)s est archivé : la connexion n'est plus possible."
msgstr "The country %(pays)s is archived: sign-in is no longer possible."

msgid "Identifiant ou mot de passe incorrect."
msgstr "Incorrect username or password."

msgid "Trop d'essais : compte verrouillé temporairement. Réessayez plus tard."
msgstr "Too many attempts: account temporarily locked. Try again later."

msgid "L'application doit décrire le téléphone."
msgstr "The app must describe the phone."

msgid "Le délai est dépassé : reconnectez-vous."
msgstr "Time is up: sign in again."

msgid "Session invalide ou expirée."
msgstr "Invalid or expired session."

msgid "Votre session a expiré. Reconnectez-vous."
msgstr "Your session has expired. Please sign in again."

msgid "Ce téléphone a été révoqué. Contactez votre administrateur pays."
msgstr "This phone has been revoked. Contact your country administrator."

msgid "Ce téléphone est déjà révoqué."
msgstr "This phone is already revoked."

msgid ""
"Ce lien est invalide, déjà utilisé ou expiré. Faites une nouvelle demande."
msgstr ""
"This link is invalid, already used or expired. Please make a new request."

msgid "Le mot de passe actuel est incorrect."
msgstr "The current password is incorrect."

msgid "Rôle inconnu."
msgstr "Unknown role."

msgid "Ce rôle est réservé aux comptes du siège."
msgstr "This role is reserved for headquarters accounts."

msgid "Ce rôle s'exerce dans un pays."
msgstr "This role is exercised in a country."

msgid ""
"Ce rôle doit porter sur le pays principal de l'utilisateur ou un pays "
"affecté."
msgstr ""
"This role must apply to the user's main country or an assigned country."

msgid "Ce compte est désactivé."
msgstr "This account is disabled."

msgid "Ce rôle est déjà attribué."
msgstr "This role is already assigned."

msgid "Ce rôle est déjà terminé."
msgstr "This role has already ended."

msgid "La fin doit suivre le début du rôle."
msgstr "The end must come after the start of the role."

msgid "Un compte du siège voit déjà tous les pays."
msgstr "A headquarters account already sees every country."

msgid "C'est déjà le pays principal de cet utilisateur."
msgstr "This is already the user's main country."

msgid "Ce rôle ne s'exerce pas dans un pays."
msgstr "This role is not exercised in a country."

msgid "Le motif est obligatoire."
msgstr "A reason is required."

msgid "Une affectation ne peut pas commencer dans le passé."
msgstr "An assignment cannot start in the past."

msgid "La fin doit suivre le début."
msgstr "The end must come after the start."

msgid "Une affectation dans ce pays est déjà en cours ou prévue."
msgstr "An assignment in this country is already ongoing or planned."

msgid "Cette affectation est déjà terminée."
msgstr "This assignment has already ended."

msgid "La fin ne peut pas être dans le passé."
msgstr "The end cannot be in the past."

msgid "Un compte du siège n'a pas de pays principal."
msgstr "A headquarters account has no main country."

msgid "L'utilisateur est déjà dans ce pays."
msgstr "The user is already in this country."

msgid ""
"Votre rôle impose la double authentification : activez-la pour continuer."
msgstr "Your role requires two-step verification: turn it on to continue."

msgid "En-tête X-Innov-Client manquant."
msgstr "Missing X-Innov-Client header."

msgid "Opération inconnue."
msgstr "Unknown operation."

msgid "Vous ne pouvez pas suspendre votre propre compte."
msgstr "You cannot suspend your own account."

msgid "Vous ne pouvez pas retirer votre propre rôle d'administrateur."
msgstr "You cannot remove your own administrator role."

msgid "Pays inconnu ou archivé."
msgstr "Unknown or archived country."

msgid "L'archive doit contenir un seul fichier JSON."
msgstr "The archive must contain a single JSON file."

msgid "Fichier illisible : JSON ou ZIP d'export BirdNotes attendu."
msgstr "Unreadable file: a BirdNotes JSON or ZIP export is expected."

msgid "Ce fichier n'est pas un export BirdNotes (clé « donnees » absente)."
msgstr "This file is not a BirdNotes export (\"donnees\" key missing)."

msgid "Téléphone inexploitable, non repris."
msgstr "Unusable phone number, not imported."

msgid "Secteur sans nom."
msgstr "Sector without a name."

#, python-brace-format
msgid "« {nom} » est une variante d'un secteur déjà repris : fusionné."
msgstr "\"{nom}\" is a variant of a sector already imported: merged."

msgid ""
"Les secteurs nouveaux sont dans une zone « À répartir » : rattachez-les à "
"leur zone dans Organisation."
msgstr ""
"New sectors are in a \"To be assigned\" zone: attach them to their zone in "
"Organisation."

msgid "Localité sans nom ou d'un secteur inconnu."
msgstr "Locality without a name or in an unknown sector."

msgid "Produit sans nom."
msgstr "Product without a name."

msgid "Produit inconnu."
msgstr "Unknown product."

#, python-brace-format
msgid "{n} produits"
msgstr "{n} products"

msgid ""
"Produits de la gamme technique « Default » seulement : rangez-les dans un "
"portefeuille ou archivez-les."
msgstr ""
"Products only in the technical \"Default\" range: put them in a portfolio or"
" archive them."

msgid "Établissement sans secteur ni prospect rattaché : non repris."
msgstr "Facility with no sector and no linked prospect: not imported."

msgid "Établissement sans nom ou sans secteur connu."
msgstr "Facility without a name or a known sector."

#, python-brace-format
msgid "{n} établissements"
msgstr "{n} facilities"

msgid ""
"Sans secteur dans BirdNotes : secteur déduit de leurs prospects, à vérifier."
msgstr ""
"No sector in BirdNotes: sector inferred from their prospects, to be checked."

msgid "Type non reconnu d'après le nom : classés « Autre », à préciser."
msgstr "Type not recognised from the name: filed as \"Other\", to be specified."

msgid "Prospect sans nom."
msgstr "Prospect without a name."

#, python-brace-format
msgid "Spécialité inconnue « {libelle} »."
msgstr "Unknown specialty \"{libelle}\"."

msgid "Type de prospect introuvable."
msgstr "Prospect type not found."

msgid "Potentiel absent ou inconnu."
msgstr "Missing or unknown potential."

#, python-brace-format
msgid "Potentiel « {brut} » ramené à « {potentiel} »."
msgstr "Potential \"{brut}\" brought back to \"{potentiel}\"."

msgid "Titre saisi à la place du prénom : prénom et nom à séparer à la main."
msgstr ""
"Title entered instead of the first name: first name and surname to be "
"separated by hand."

#, python-brace-format
msgid "{n} groupes"
msgstr "{n} groups"

#, python-brace-format
msgid ""
"Fiches au même nom ({n}) : gardées pour la file des doublons, où le "
"superviseur tranchera (0.1.8)."
msgstr ""
"Records sharing the same name ({n}): kept for the duplicates queue, where "
"the supervisor will decide (0.1.8)."

#, python-brace-format
msgid "{n} fiches"
msgstr "{n} records"

msgid ""
"Localité « INTERMEDIARE » dans BirdNotes, qui n'en est pas une : secteur "
"gardé, localité à préciser."
msgstr ""
"\"INTERMEDIARE\" locality in BirdNotes, which is not one: sector kept, "
"locality to be specified."

msgid ""
"Doublons probables signalés par BirdNotes : gardés pour la file des doublons"
" (0.1.8)."
msgstr ""
"Probable duplicates flagged by BirdNotes: kept for the duplicates queue "
"(0.1.8)."

#, python-brace-format
msgid "{n} demandes"
msgstr "{n} requests"

msgid ""
"Demandes de modification en attente dans BirdNotes : à traiter avec les "
"propositions de modification (0.1.8)."
msgstr ""
"Change requests pending in BirdNotes: to be handled with change proposals "
"(0.1.8)."

msgid "Entité"
msgstr "Entity"

msgid "Identifiant source"
msgstr "Source identifier"

msgid "Niveau"
msgstr "Level"

msgid "Motif"
msgstr "Reason"

msgid "Ce libellé ou ce code est déjà utilisé."
msgstr "This label or code is already in use."

msgid "Ce champ est obligatoire."
msgstr "This field is required."

msgid "Élément inconnu ou archivé dans ce pays."
msgstr "Unknown or archived item in this country."

msgid "Un élément archivé ne se modifie plus."
msgstr "An archived item can no longer be changed."

msgid "Archivez d'abord les réseaux de cette division."
msgstr "Archive this division's networks first."

msgid "Archivez d'abord les secteurs de cette zone."
msgstr "Archive this zone's sectors first."

msgid "Rattachez d'abord les établissements de ce secteur à un autre."
msgstr "First attach this sector's institutions to another one."

msgid "Terminez d'abord l'occupation de ce poste."
msgstr "End this position's occupancy first."

msgid "Type de poste inconnu."
msgstr "Unknown position type."

msgid "Ce lien est déjà terminé."
msgstr "This link has already ended."

msgid "La fin ne peut pas précéder le début."
msgstr "The end cannot precede the start."

msgid "Ce poste est archivé."
msgstr "This position is archived."

msgid "Seul un délégué ou un superviseur de ce pays peut occuper un poste."
msgstr ""
"Only a representative or a supervisor of this country can hold a position."

msgid "Ce poste est déjà occupé à cette date."
msgstr "This position is already held on that date."

msgid "Cette personne occupe déjà ce poste."
msgstr "This person already holds this position."

msgid "Seul un superviseur ou un DM de ce pays peut être choisi."
msgstr "Only a supervisor or a DM of this country can be chosen."

msgid "Un rattachement commence déjà à cette date ou après."
msgstr "A reporting line already starts on or after this date."

msgid "Ce réseau est archivé."
msgstr "This network is archived."

msgid "Seul un DF ou un DM de ce pays a un périmètre de réseaux."
msgstr "Only a DF or a DM of this country has a network scope."

msgid "Ce réseau est déjà dans le périmètre."
msgstr "This network is already in the scope."

msgid "Choisissez d'abord un pays."
msgstr "Choose a country first."

msgid "Personne inconnue dans ce pays."
msgstr "Unknown person in this country."

msgid "Action non autorisée."
msgstr "Action not allowed."

msgid "Vous n'avez pas accès à ce pays."
msgstr "You do not have access to this country."

msgid "La fréquence cible va de 1 à 20 visites par cycle."
msgstr "The target frequency ranges from 1 to 20 visits per cycle."

msgid ""
"Seuls le superviseur du poste et l'administrateur pays tiennent cette liste."
msgstr ""
"Only the position's supervisor and the country administrator maintain this "
"list."

msgid "Seule une fiche active du pays entre dans une liste cible."
msgstr "Only an active record of the country can enter a target list."

msgid "Ce prospect n'est plus dans la liste cible."
msgstr "This prospect is no longer in the target list."

msgid "Portée de recherche inconnue."
msgstr "Unknown search scope."

msgid "Ce numéro de téléphone n'est pas valide."
msgstr "This phone number is not valid."

msgid "Valeur inconnue ou archivée dans ce pays."
msgstr "Unknown or archived value in this country."

msgid "Activité inconnue (hospitalier ou privé)."
msgstr "Unknown practice (hospital or private)."

msgid "Localité inconnue ou archivée dans ce pays."
msgstr "Unknown or archived locality in this country."

msgid "Cette localité n'appartient pas au secteur choisi."
msgstr "This locality does not belong to the chosen sector."

msgid "Un établissement appartient à un secteur."
msgstr "An institution belongs to a sector."

msgid "Secteur inconnu ou archivé dans ce pays."
msgstr "Unknown or archived sector in this country."

msgid "Le nom est obligatoire."
msgstr "The last name is required."

msgid "Le type de prospect est obligatoire."
msgstr "The prospect type is required."

msgid "Cette spécialité ne s'applique pas à ce type de prospect."
msgstr "This specialty does not apply to this prospect type."

msgid "La spécialité est obligatoire pour ce type."
msgstr "The specialty is required for this type."

msgid "Le potentiel est obligatoire."
msgstr "The potential is required."

msgid "Civilité inconnue."
msgstr "Unknown title."

msgid "Ce numéro d'ordre est déjà celui d'une autre fiche de ce pays."
msgstr ""
"This licence number already belongs to another record in this country."

msgid "Une fiche archivée ne se modifie plus."
msgstr "An archived record can no longer be edited."

msgid "Cette fiche n'est pas à valider."
msgstr "This record is not awaiting validation."

msgid "Fiche archivée"
msgstr "Record archived"

msgid "Coordonnées GPS invalides."
msgstr "Invalid GPS coordinates."

msgid "Le type d'établissement est obligatoire."
msgstr "The institution type is required."

msgid "Indiquez la latitude et la longitude, ou aucune des deux."
msgstr "Enter both latitude and longitude, or neither."

msgid "Établissement inconnu dans ce pays."
msgstr "Unknown facility in this country."

msgid "Un exercice relie une fiche prospect et un établissement en service."
msgstr ""
"A practice links a prospect record and a facility that are in service."

msgid "Ce prospect exerce déjà dans cet établissement."
msgstr "This prospect already practises in this facility."

msgid "Cet exercice est terminé."
msgstr "This practice has ended."

msgid "La fin ne peut précéder le début de l'exercice."
msgstr "The end cannot precede the start of the practice."

msgid "Seul l'administrateur pays modifie une fiche commune."
msgstr "Only the country administrator edits a shared record."

msgid "Ce libellé ou ce code est déjà utilisé dans cette liste."
msgstr "This label or code is already used in this list."

msgid "Cette liste n'a pas de valeur parente."
msgstr "This list has no parent value."

msgid "Liste inconnue."
msgstr "Unknown list."

msgid "Archivez d'abord les valeurs qui dépendent de celle-ci."
msgstr "Archive the values that depend on this one first."

msgid "Changez d'abord la classe des produits de cette classe."
msgstr "First change the class of this class's products."

msgid "Une valeur active porte déjà ce libellé ou ce code."
msgstr "An active value already has this label or code."

msgid "Authentification requise."
msgstr "Authentication required."

msgid "Ressource introuvable."
msgstr "Resource not found."

msgid "Trop de tentatives, réessayez plus tard."
msgstr "Too many attempts, try again later."

msgid "Données invalides."
msgstr "Invalid data."

#, python-format
msgid ""
"Une erreur inattendue s'est produite. Si elle se répète, donnez la référence"
" %(reference)s au support."
msgstr ""
"An unexpected error occurred. If it happens again, give reference "
"%(reference)s to support."

msgid "Bienvenue dans INNOV CRM."
msgstr "Welcome to INNOV CRM."

msgid "Français"
msgstr "French"

msgid "Anglais"
msgstr "English"
